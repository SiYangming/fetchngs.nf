/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for running the fetchngs pipeline on a production server
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    由原 fetchngs_custom_config_template.config / fetchngs_unified_config.config /
    SRP189094.config / PRJNA974167.config 合并而来。

    Usage（个性化参数 input/outdir 通过命令行指定）：
        nextflow run main.nf -profile server,docker \
            --input samplesheets/SRP189094/SRR_Acc_List.csv \
            --outdir /data1/users/siyangming/rice/osa_Japonica/SRP189094/fastq

        nextflow run main.nf -profile server,docker \
            --input samplesheets/PRJNA974167/SRR_Acc_List.csv \
            --outdir /data1/users/siyangming/rice/osa_Japonica/PRJNA974167/fastq

    资源上限通过 --max_cpus / --max_memory / --max_time 覆盖。
----------------------------------------------------------------------------------------
*/

params {
    config_profile_name        = 'Server profile'
    config_profile_description = 'Production configuration for fetchngs pipeline (128 CPUs / 503GB memory server)'

    // 下载方法：ftp | aspera | sratools | kingfisher | fastqdl
    download_method = 'ftp'
    skip_fastq_download = false

    // 资源上限（可用命令行 --max_cpus 等覆盖）
    max_cpus   = 120
    max_memory = '500.GB'
    max_time   = '240.h'

    // 输入列表（默认 null，必须通过 --input 命令行指定）
    input = null

    // 流程集成选项（按需通过命令行启用）
    // nf_core_pipeline            = 'rnaseq'
    // nf_core_rnaseq_strandedness = 'auto'
    // sample_mapping_fields       = 'experiment_accession,run_accession,sample_accession,experiment_alias,run_alias,sample_alias,experiment_title,sample_title,sample_description'

    // 发布配置
    publish_dir_mode = 'copy'
}

// =========================================================================
// Global executor — server has 128 CPUs / 503 GB memory.
// Keep 32 cores and ~100 GB free for system/other users.
// =========================================================================
executor {
    name       = 'local'
    cpus       = 96
    memory     = '400 GB'
    queueSize  = 20
}

process {
    executor = 'local'

    // ---- 全局默认资源 ----
    cpus   = 4
    memory = '12.GB'
    time   = '8.h'

    // ---- 错误处理策略 ----
    errorStrategy = { task.exitStatus in [143,137,104,134,139] ? 'retry' : 'finish' }
    maxRetries    = 2
    maxErrors     = '-1'

    // ---- 按标签分配资源 ----
    withLabel: process_single {
        cpus   = 1
        memory = '6.GB'
        time   = '4.h'
    }
    withLabel: process_low {
        cpus   = 2
        memory = '12.GB'
        time   = '4.h'
    }
    withLabel: process_medium {
        cpus   = 6
        memory = '36.GB'
        time   = '8.h'
    }
    withLabel: process_high {
        cpus   = 12
        memory = '72.GB'
        time   = '16.h'
    }
    withLabel: process_long {
        time   = '20.h'
    }
    withLabel: process_high_memory {
        memory = '200.GB'
    }

    // ---- SRA 元数据转换 ----
    withName: 'SRA_IDS_TO_RUNINFO' {
        cpus   = 2
        memory = '12.GB'
        time   = '2.h'
    }
    withName: 'SRA_RUNINFO_TO_FTP' {
        cpus   = 1
        memory = '6.GB'
        time   = '1.h'
    }

    // ---- FTP 下载（wget 断点续传 + 网络重试）----
    withName: 'SRA_FASTQ_FTP' {
        cpus   = 4
        memory = '12.GB'
        time   = '8.h'
        maxRetries = 3
        maxForks   = 8

        // wget 参数：重试 15 次、断点续传、300s 超时、连接拒绝重试、DNS 超时
        ext.args = '-t 15 -nv -c -T 300 --waitretry=20 --retry-connrefused --read-timeout=300 --dns-timeout=60'
    }

    // ---- Aspera 下载（按需使用）----
    withName: 'ASPERA_CLI' {
        cpus   = 4
        memory = '16.GB'
        time   = '8.h'
        maxRetries = 3
        ext.args = '-l 300M -P 33001 -k 1'
    }

    // ---- SRA-tools 下载（按需使用）----
    withName: 'SRATOOLS_PREFETCH' {
        cpus   = 2
        memory = '16.GB'
        time   = '8.h'
        maxRetries = 3
        ext.args = '--max-size 100G'
    }
    withName: 'SRATOOLS_FASTERQDUMP' {
        cpus   = 6
        memory = '36.GB'
        time   = '12.h'
        ext.args = '--split-files --include-technical'
    }

    // ---- 生成 samplesheet ----
    withName: 'SRA_TO_SAMPLESHEET' {
        cpus   = 1
        memory = '6.GB'
        time   = '1.h'
        publishDir = [
            path: { "${params.outdir}/samplesheet" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename }
        ]
    }
}

// Container engine — Docker only on this server
singularity {
    enabled = false
}

docker {
    enabled = true
}

conda {
    enabled = false
}

// Reports overwrite to avoid warnings on resume
trace {
    enabled   = true
    overwrite = true
    file      = "${params.outdir}/pipeline_info/execution_trace.txt"
}

report {
    enabled   = true
    overwrite = true
    file      = "${params.outdir}/pipeline_info/execution_report.html"
}

timeline {
    enabled   = true
    overwrite = true
    file      = "${params.outdir}/pipeline_info/execution_timeline.html"
}
